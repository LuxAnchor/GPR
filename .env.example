# Vercel Blob Storage Token
# 从Vercel Storage -> Blob获取
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Neon PostgreSQL Database URL
# 从Neon.tech控制台获取
# 格式: postgresql://username:password@host/database?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxx-xxx-xxx-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key
# 建议使用至少32位的随机字符串
# 可以使用: openssl rand -base64 32 生成
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters
